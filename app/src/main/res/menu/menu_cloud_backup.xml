<?xml version="1.0" encoding="utf-8"?>
<!--
  The Backed-up files toolbar (shown while NOT multi-selecting; selection swaps
  in menu_action). Search + the grid/list toggle as icons, mirroring the
  Downloads list; the toggle's icon is set per state by the fragment's
  MenuProvider (grid icon while in list mode, list icon while in grid mode).
  "Restore all" and "Backup" (the settings screen) are the OVERFLOW items —
  they are what create the ⋮ on this screen at all.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Filter the backed-up files by name. Tapping it reveals the full-width
         in-toolbar search field (toolbar_search_field) — the same bar the
         Downloads list uses, NOT a collapsible SearchView (which rendered as a
         narrow non-full-width widget). The fragment filters its in-memory list. -->
    <item
        android:id="@+id/action_search"
        android:icon="@drawable/ic_search_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="ifRoom"
        android:title="@string/search"/>
    <item
        android:id="@+id/action_view"
        android:icon="@drawable/ic_grid_view_24"
        app:iconTint="?attr/colorOnSurface"
        app:showAsAction="ifRoom"
        android:title="@string/popup_toggle"/>
    <!-- "Restore all to this phone": every cloud-only entry back into Downloads
         (Signal's "Download your backup data"; the counterpart of the Storage
         screen's "Free up space"). Visibility is set per invalidate by the
         fragment — shown only while something is cloud-only and not already
         restoring, so it never offers to restore nothing. -->
    <item
        android:id="@+id/action_restore_all"
        app:showAsAction="never"
        android:title="@string/cloud_restore_all"/>
    <!-- The only route from this list to the Backup screen (the folder, the
         recovery code, the erasure door, the bookmarks switch). For a SET-UP
         folder the Downloads overflow lands on this list rather than on the
         Backup screen, so without this entry those rows were reachable only
         from the Home or Browser popup — and this is the screen that most
         invites them, since it is where you are looking at the files you might
         erase. -->
    <item
        android:id="@+id/action_cloud_settings"
        app:showAsAction="never"
        android:title="@string/settings_account_title"/>
</menu>
