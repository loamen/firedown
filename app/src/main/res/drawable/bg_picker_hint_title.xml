<?xml version="1.0" encoding="utf-8"?>
<!-- The title placeholder in the Backup chooser's picker miniature: a
     skeleton line rather than a folder name, because the picker may open on
     any folder and the picture should not promise one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="?attr/colorOutlineVariant" />
    <corners android:radius="3dp" />
</shape>
