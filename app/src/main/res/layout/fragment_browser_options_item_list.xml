<?xml version="1.0" encoding="utf-8"?>
<!--
  Captured-content ROW: every capture that isn't an image (video, audio,
  subtitle, other files). Images are squares (fragment_browser_options_square).
  See CaptureItem for the sheet's layout and the canvas "Captured Content
  sheet", option A.

  Structure mirrors fragment_download_item.xml AND its selection chrome:
  the MaterialCardView is the ROOT, the check (item_download_more_checked)
  overlays the more-button's own slot — the adapter swaps them on the
  action-mode toggle (more INVISIBLE, check VISIBLE) so the row never
  reflows — and the selected state paints a tonal WASH on the card via
  the adapter, not a stroke border.

  ONE meta line under the title (row_meta), built by the adapter as a single
  spannable: "[status] · [TYPE] · facts · [domain]". It replaced a mime label,
  a domain line and a tag row of five TextViews; one line keeps every row the
  same height and lets the status lead the facts it describes.

  row_progress is the download's progress along the card's bottom edge,
  shown only while the capture is downloading (the meta line carries the
  percent). Card background is surfaceContainerLow with zero elevation: the
  sheet's appbar doesn't lift, so rows need some per-row containment, and
  the one deliberate difference from Downloads' transparent card stays.
  Margins come from CaptureSpacingDecoration, not the layout.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/list_margin"
        android:minHeight="@dimen/list_download_image_height">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/image"
            android:layout_width="@dimen/list_download_image_width"
            android:layout_height="@dimen/list_download_image_height"
            android:adjustViewBounds="true"
            android:background="@drawable/mask_image_rounded"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Text column: title / meta. wrap_content height with top+bottom
             parent constraints: centred when shorter than the thumbnail, and
             the row grows when a large font scale needs the room. -->
        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/item_download_more"
            app:layout_constraintStart_toEndOf="@id/image"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/file_name"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface"
                tools:text="Northern Lights" />

            <TextView
                android:id="@+id/row_meta"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="VIDEO · 720p · 0:08 · clips.example" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/item_download_more"
            style="@style/Theme.FireDown.More.Button"
            app:icon="@drawable/ic_baseline_more_vert_24"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Selection checkmark — overlays the more-button's slot; see the
             header comment. -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/item_download_more_checked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/item_download_more"
            app:layout_constraintEnd_toEndOf="@id/item_download_more"
            app:layout_constraintStart_toStartOf="@id/item_download_more"
            app:layout_constraintTop_toTopOf="@id/item_download_more"
            app:srcCompat="@drawable/ic_baseline_check_circle_24" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/row_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:indicatorTrackGapSize="0dp"
        app:trackCornerRadius="0dp"
        app:trackStopIndicatorSize="0dp"
        app:trackThickness="3dp" />

</com.google.android.material.card.MaterialCardView>
