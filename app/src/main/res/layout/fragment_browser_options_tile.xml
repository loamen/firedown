<?xml version="1.0" encoding="utf-8"?>
<!--
  Captured-content TILE: a video capture, two to a line on a phone (canvas
  "Captured Content sheet", board F). The picture leads because the name
  often can't: a player embedded in another page is captured as "src",
  "master" or a hash, and the frame is then the only thing that says which
  video it is. See CaptureItem.

  The root card is the touch target (transparent, its ripple covers the
  picture and the text under it). tile_picture is the 16:9 picture card:
  its 2dp stroke and the corner check are the selection chrome, as on every
  grid tile. Over the picture, the photo-tile convention: quality at the
  bottom start and duration at the bottom end, white with a shadow over the
  bottom_scrim; the adapter drops the scrim and switches to FallbackInks
  when the slot shows the mime placeholder. The ⋮ (multi-variant captures
  only, opens the quality picker) sits in the top-end corner with no scrim
  behind it, the grid rule.

  Under the picture: the name (two lines) and one status line, built by the
  adapter: "[status] · [CC n] · [domain]", hidden when empty. A running
  download also shows tile_progress along the picture's bottom edge.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="@dimen/card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tile_picture"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp"
            app:layout_constraintDimensionRatio="H,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/transparent"
            app:strokeWidth="2dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:id="@+id/bottom_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bottom_scrim"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/tile_quality"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="720p" />

                <TextView
                    android:id="@+id/tile_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="2:01:32" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/tile_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:visibility="gone"
                app:indicatorTrackGapSize="0dp"
                app:trackCornerRadius="0dp"
                app:trackStopIndicatorSize="0dp"
                app:trackThickness="3dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_download_more"
                style="@style/Theme.FireDown.More.Button"
                android:layout_gravity="top|end"
                android:visibility="gone"
                app:icon="@drawable/ic_baseline_more_vert_24" />

            <!-- Selection indicator (action mode): the ⋮'s corner. -->
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/item_download_more_checked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:contentDescription="@null"
                android:padding="@dimen/button_icons_padding"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_baseline_check_circle_24"
                app:tint="?attr/brandInk" />

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/file_name"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tile_picture"
            tools:text="Ambient visuals for focus and deep work, two hours" />

        <TextView
            android:id="@+id/row_meta"
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/file_name"
            tools:text="CC 1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
