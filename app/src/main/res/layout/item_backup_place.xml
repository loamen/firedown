<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the Backup screen's "Where to back up" chooser
     (SyncSettingsFragment.showPlaceChooser): the app's own icon (a cloud
     app) or the chooser's glyph (a removable volume, "Somewhere else"), the
     place, and the one instruction that goes with tapping it. The 24dp
     gutter is the M3 dialog inset, not the 16dp sheet row's. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="24dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/place_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@null"
        tools:src="@drawable/folder_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/place_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Google Drive" />

        <TextView
            android:id="@+id/place_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="@string/folder_backup_place_cloud_sub" />

    </LinearLayout>

</LinearLayout>
