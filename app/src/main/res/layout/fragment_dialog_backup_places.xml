<?xml version="1.0" encoding="utf-8"?>
<!--
    The Backup screen's "Where to back up" sheet (BackupPlacesSheetDialogFragment):
    a label, ONE group of grouped sheet cards (one per KIND of place: cloud
    storage with the picker miniature, a WebDAV server, the SD card / USB
    drive while one is in, "Somewhere else"), then one footnote, that a cloud
    app appears under the picker's ☰ once signed in. It was a centred
    MaterialAlertDialog with a Cancel button, the one menu in the app that
    was not a sheet; a list of places to pick from is a menu, so it wears the
    sheets' shape (the handle, the cards, swipe or tap outside to dismiss).

    Each row is two or three lines, so it is not a SheetRowText: the glyph
    (24dp, the sheet rows' size) sits top-aligned with the title's first line,
    the M3 rule for a multi-line item, and the instruction under the title is
    the settings summary type (BodyMedium), the screen the sheet opens from.
    The removable-volume row hides when no card is in, so the fragment runs
    SheetGroups.applyCorners on the group after setting it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="8dp">

    <include layout="@layout/dialog_drag_handle" />

    <TextView
        style="@style/TextAppearance.Material3.TitleMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:text="@string/folder_backup_pick_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/places_group"
                style="@style/Firedown.Widget.SheetGroup"
                android:layout_marginHorizontal="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/place_cloud"
                    style="@style/Firedown.Widget.SheetRowCard"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupTop">

                    <LinearLayout style="@style/Firedown.Widget.SheetPlaceRow">

                        <ImageView
                            style="@style/Firedown.Widget.SheetPlaceIcon"
                            android:src="@drawable/cloud_outline_24"
                            app:tint="?attr/brandInk" />

                        <LinearLayout style="@style/Firedown.Widget.SheetPlaceText">

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceTitle"
                                android:text="@string/folder_backup_place_cloud" />

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceSub"
                                android:text="@string/folder_backup_place_cloud_sub" />

                            <include layout="@layout/layout_backup_picker_hint" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/place_webdav"
                    style="@style/Firedown.Widget.SheetRowCard"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupMiddle">

                    <LinearLayout style="@style/Firedown.Widget.SheetPlaceRow">

                        <ImageView
                            style="@style/Firedown.Widget.SheetPlaceIcon"
                            android:src="@drawable/dns_24" />

                        <LinearLayout style="@style/Firedown.Widget.SheetPlaceText">

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceTitle"
                                android:text="@string/folder_backup_place_webdav" />

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceSub"
                                android:text="@string/folder_backup_place_webdav_sub" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/place_volume"
                    style="@style/Firedown.Widget.SheetRowCard"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupMiddle"
                    tools:visibility="visible">

                    <LinearLayout style="@style/Firedown.Widget.SheetPlaceRow">

                        <ImageView
                            style="@style/Firedown.Widget.SheetPlaceIcon"
                            android:src="@drawable/sd_card_24" />

                        <LinearLayout style="@style/Firedown.Widget.SheetPlaceText">

                            <TextView
                                android:id="@+id/place_volume_title"
                                style="@style/Firedown.Widget.SheetPlaceTitle"
                                tools:text="@string/folder_backup_provider_sd" />

                            <TextView
                                android:id="@+id/place_volume_sub"
                                style="@style/Firedown.Widget.SheetPlaceSub"
                                tools:text="@string/folder_backup_place_removable_sub" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/place_other"
                    style="@style/Firedown.Widget.SheetRowCard"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.FireDown.SheetGroupBottom">

                    <LinearLayout style="@style/Firedown.Widget.SheetPlaceRow">

                        <ImageView
                            style="@style/Firedown.Widget.SheetPlaceIcon"
                            android:src="@drawable/folder_24" />

                        <LinearLayout style="@style/Firedown.Widget.SheetPlaceText">

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceTitle"
                                android:text="@string/folder_backup_place_other" />

                            <TextView
                                style="@style/Firedown.Widget.SheetPlaceSub"
                                android:text="@string/folder_backup_place_other_sub" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Under the group, on the glyph column (16dp margin + 16dp card
                 padding), where the Backups item sheet puts its footnote. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="32dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:text="@string/folder_backup_place_signin"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
