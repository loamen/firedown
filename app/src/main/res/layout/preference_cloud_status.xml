<?xml version="1.0" encoding="utf-8"?>
<!--
  The Backup status hero (custom Preference layout, bound by
  CloudStatusPreference). One card, three states:

    A · set up, folder reachable — folder glyph, "Firedown Backup" over
                                   "On <provider>" (the folder's own name and
                                   whose storage it sits in), the backed-up
                                   size headline, and a caption with the file
                                   count — or the ⋮-menu hint while nothing is
                                   backed up yet
    B · set up, folder LOST      — the same frame with the folder-off glyph,
                                   "Can't reach your backup folder", the last
                                   seen totals, and the body line that says
                                   what to do (cb_alert)
    C · not set up               — the dashed onboarding roadmap
                                   (① recovery code → ② folder → ③ first
                                   backup)

  No quota, no meter, no chip: the folder is the user's own storage, so the
  only facts this card can state are what is in it and whether it answers.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="16dp">

    <!-- ── set-up hero (reachable AND lost — the class swaps glyph/copy) ── -->
    <LinearLayout
        android:id="@+id/cb_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/cb_glyph"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_folder_upload_24"
                app:tint="?attr/colorOnSurfaceVariant"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cb_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="@string/folder_backup_hero_title" />

                <TextView
                    android:id="@+id/cb_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="On Google Drive" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <!-- baselineAligned keeps the small unit label sitting on the big
                 figure's baseline. -->
            <TextView
                android:id="@+id/cb_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="854 MB" />

            <TextView
                android:id="@+id/cb_big_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="@string/cloud_status_backed_up" />

        </LinearLayout>

        <TextView
            android:id="@+id/cb_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="14 files · encrypted end-to-end" />

        <!-- The folder-LOST body line (colorError ink — the readable attention
             ink on both surfaces; never backup_warning amber, 2.09:1 on light). -->
        <TextView
            android:id="@+id/cb_alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12.5sp"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="@string/folder_backup_lost_body" />

    </LinearLayout>

    <!-- ── not-set-up: the onboarding roadmap ── -->
    <LinearLayout
        android:id="@+id/cb_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_cloud_empty_dashed"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_folder_upload_24"
                app:tint="?attr/colorOnSurfaceVariant"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:text="@string/cloud_status_empty_title" />

        </LinearLayout>

        <!-- Three roadmap lines; CloudStatusPreference prefixes ✓ / N · and
             sets the ink (full-contrast bold = the current step). -->
        <TextView
            android:id="@+id/cb_step_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12.5sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="1 ·  Create recovery code" />

        <TextView
            android:id="@+id/cb_step_folder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12.5sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="2 ·  Choose backup folder" />

        <TextView
            android:id="@+id/cb_step_backup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12.5sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3 ·  Back up a finished download from its ⋮ menu." />

    </LinearLayout>

</LinearLayout>
