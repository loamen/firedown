<?xml version="1.0" encoding="utf-8"?>
<!--
    THE HOME IS THE MARK OVER THE FIELD (home v6). Top-down: the flame, the
    wordmark, and the search pill right under them, all centred — the Google /
    DuckDuckGo start-page shape, with Firedown's own mark as the subject. There
    is deliberately NO stat line, no top sites, no recent history, no download
    rows and no chip row: top sites and recents are what Chrome and Brave do,
    download status overlaps the Downloads screen, and the one-line counters
    that used to sit under the wordmark wrapped onto two rows on 360dp phones
    in the long locales (two chips plus a dot needed 304dp of a 296dp line).
    What the home still carries: the ember behind the flame while a download
    runs (status with no number), and the cloud-backup chip / deadline card
    below the field (rare, evidence-based, see HomeFragment.applyBackupPill).

    THE PILL IS THE REAL GeckoToolbar. It is a direct child of this
    CoordinatorLayout laid out at the TOP (the exact rect the browser's
    toolbar occupies), and HomeToolbarDock translates it DOWN over the
    home_search_slot Space the content reserves; on focus it rises back to the
    top and the suggestions open under it (AutoCompleteViewBehavior follows
    the toolbar's translation, as in the browser). Three things this layout
    must keep for that to work:
      - the toolbar is NOT inside an AppBarLayout (a LinearLayout clips a
        translated child to its own bounds, so the docked pill would vanish),
        and it is declared AFTER the scroll view so it draws above the content
        and receives the tap;
      - the toolbar carries NO self-padding for the status inset — HomeFragment
        gives it a top MARGIN instead, so the box is a plain 64dp bar whose
        pill lands 8dp inside it, and the docked box's top edge sits 8dp above
        the slot rather than a whole status inset above it (which would paint
        over the wordmark);
      - the slot is exactly the pill's height, with ≥16dp of clearance below
        it, because the docked box extends 8dp past the slot on both sides and
        its holder is an opaque surface.
    The AutoCompleteView has no XML behavior: HomeFragment installs
    AutoCompleteViewBehavior in code (it needs the view reference), the same
    way the browser does.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <!-- The content. Top padding = the status inset and bottom padding = the
         nav inset (HomeFragment's insets listener); the bottom margin reserves
         the bottom bar. fillViewport stretches the FrameLayout to the
         viewport so the mark centres in it. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">


            <!-- The brand mark + the field's slot + the cloud surfaces, as ONE
                 group centred in the viewport. match_parent (centred by
                 gravity, not width) so the deadline card below gets the real
                 line width. The bottom margin is the OPTICAL LIFT: FrameLayout
                 centres the box including margins, so the group sits that much
                 above the true centre (a start page's field sits above the
                 middle, not on it; values-land shrinks it). HomeToolbarDock
                 fades this whole group while the pill is raised. -->
            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="@dimen/home_mark_lift"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- Flame + the breathing ember glow behind it. 56dp — the
                     subject of the screen, not an app icon (it was 40dp when a
                     stat line shared the block). The glow is the flame's size
                     and only becomes a halo via the animator's SCALE
                     transform, drawn beyond the box because this and the
                     ancestors set clipChildren="false". The glow is GONE/alpha
                     0 at rest — HomeFragment shows it and runs the breath only
                     while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Where the pill rests. Exactly the pill's 48dp; the toolbar
                     is drawn over it (see the file comment). 28dp under the
                     wordmark: the docked toolbar box starts 8dp above this
                     slot, which leaves 20dp of clear canvas under the text. -->
                <Space
                    android:id="@+id/home_search_slot"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp" />

                <!-- Cloud Backup transfer CHIP (home v5) — "Backing up…" /
                     "Waiting to back up" ONLY, GONE otherwise. A fill is earned
                     by WORK — transient, self-clearing — never by a standing
                     state. The resting "N backed up" quiet line that used to
                     share a fixed-height slot with this chip, and the Settings
                     switch that let the user hide it, were REMOVED together:
                     the line was a standing claim off a late network total
                     (already demoted from a chip once — "the most important
                     item on the home fragment" on two devices), and the
                     switch existed only to silence it. With no resting state
                     there is no late arrival to reserve height for, so the
                     slot went too; a chip that mounts when a backup STARTS may
                     move the block (it is an event, like the card below).

                     NO action label. It read "VIEW" on every state, so it
                     said only "tappable" — which the chip shape and the
                     ripple already say. It also cost ~50dp on a wrap_content
                     pill that must fit "Waiting to back up" and its
                     translations, and it had already been trimmed once: its
                     hardcoded ?attr/colorPrimary measured 1.68:1 light /
                     3.76:1 dark, and the fix note read "bold + allCaps
                     already say action" — if the shape says it and the
                     weight says it, the word is the third copy. The CARD
                     keeps "TOP UP": a real verb for a real decision (spend
                     money, against a deadline) and the only state whose tap
                     goes somewhere other than the Backups list. Don't
                     re-add one here.

                     24dp under the slot: the docked toolbar box ends 8dp past
                     the slot, so the chip clears it by 16dp. Ground, ink and
                     the upload glyph are all STATIC. At most ONE of chip /
                     card is ever VISIBLE. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_backup_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_cloud_upload_24"
                            app:tint="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/home_backup_pill_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            tools:text="Backing up…" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Backup DEADLINE card. A different SILHOUETTE from the pill
                     above, on purpose: the pill reports ambient progress that
                     resolves itself, this reports a 30-day deadline that ends in
                     deleted files. Wide, two lines, a verb — the SHAPE is what
                     says "this one matters", not a colour. It carries no
                     semantic hue at all; see the note in values/colors.xml.

                     match_parent inside the group's address_bar_inset padding,
                     so the card is 16dp from the screen edge — the same inset
                     as the address bar's pill family. The pill is wrap_content
                     and centred, so the two never share a width — that
                     difference is load-bearing, not incidental.

                     The detail line WRAPS to 2 lines (no singleLine): the
                     countdown is a full sentence and grows in translation, so it
                     must not ellipsize the deadline away. The action is
                     wrap_content beside a weighted text column, so a long
                     message shrinks the text rather than squeezing the verb out.
                     Only ONE of pill/card is ever VISIBLE. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_backup_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp"
                    tools:visibility="visible">

                    <!-- Two rows: the fact (icon · title / countdown) and an
                         ACTIONS row aligned end. It was one row with "TOP UP"
                         trailing the text; a second action ("Restore") in that
                         row would not fit beside a two-line countdown in the
                         long locales (German "WIEDERHERSTELLEN"), so the verbs
                         have their own row, where a translation wraps the row
                         rather than squeezing the countdown. An alarm card may
                         grow. Both actions share one shape (8dp pad, 40dp
                         minHeight) so they read as a pair; RESTORE is its own
                         tap target, the card itself is TOP UP. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingEnd="4dp">

                            <ImageView
                                android:id="@+id/home_backup_card_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/cloud_off_24"
                                app:tint="?attr/colorOnSurface" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/home_backup_card_title"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    tools:text="Backup paused" />

                                <TextView
                                    android:id="@+id/home_backup_card_detail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="2"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="12sp"
                                    tools:text="27 days left before your files are removed" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="end|center_vertical"
                            android:orientation="horizontal">

                            <!-- Signal's "Download your backup data": brings
                                 every cloud-only file back before the reap. -->
                            <TextView
                                android:id="@+id/home_backup_card_restore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:minHeight="40dp"
                                android:paddingHorizontal="8dp"
                                android:text="@string/settings_sync_restore_action"
                                android:textAllCaps="true"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/home_backup_card_action"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:gravity="center"
                                android:minHeight="40dp"
                                android:paddingHorizontal="8dp"
                                android:text="@string/home_cloud_top_up"
                                android:textAllCaps="true"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap while docked over the slot. Laid out at the top (a top
         MARGIN of the status inset, set in HomeFragment); HomeToolbarDock owns
         its translation. -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar covers search, so the centre slot
        is the bookmarks-list entry. (The former hero Bookmarks FAB was
        removed.)
    -->

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
