<?xml version="1.0" encoding="utf-8"?>
<!--
    THE HOME IS THE MARK OVER THE FIELD (home v6). Top-down: the flame, the
    wordmark, and the search pill right under them, all centred — the Google /
    DuckDuckGo start-page shape, with Firedown's own mark as the subject. There
    is deliberately NO stat line, no top sites, no recent history, no download
    rows and no chip row: top sites and recents are what Chrome and Brave do,
    download status overlaps the Downloads screen, and the one-line counters
    that used to sit under the wordmark wrapped onto two rows on 360dp phones
    in the long locales (two chips plus a dot needed 304dp of a 296dp line).
    What the home still carries: the ember behind the flame while a download
    runs (status with no number). No cloud state either (maintainer, 2026-10-12):
    the transfer chip and the grace deadline card that sat under the field went
    with their plumbing — the Backups list and CloudWatchWorker's notifications
    carry those.

    THE PILL IS THE REAL GeckoToolbar. It is a direct child of this
    CoordinatorLayout laid out at the TOP (the exact rect the browser's
    toolbar occupies), and HomeToolbarDock translates it DOWN over the
    home_search_slot Space the content reserves; on focus it is back at the
    top — a cut, not a tween — and the suggestions open under it
    (AutoCompleteViewBehavior follows the toolbar's translation, as in the
    browser). Three things this layout must keep for that to work:
      - the toolbar is NOT inside an AppBarLayout (a LinearLayout clips a
        translated child to its own bounds, so the docked pill would vanish),
        and it is declared AFTER the scroll view so it draws above the content
        and receives the tap;
      - the toolbar carries NO self-padding for the status inset — HomeFragment
        gives it a top MARGIN instead, so the box is a plain 64dp bar whose
        pill lands 8dp inside it, and the docked box's top edge sits 8dp above
        the slot rather than a whole status inset above it (which would paint
        over the wordmark);
      - the slot is exactly the pill's height and the last thing in the group,
        because the docked box extends 8dp past the slot on both sides and its
        holder is an opaque surface — anything placed under the slot needs
        ≥16dp of clearance.
    The AutoCompleteView has no XML behavior: HomeFragment installs
    AutoCompleteViewBehavior in code (it needs the view reference), the same
    way the browser does.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <!-- The content. Top padding = the status inset and bottom padding = the
         nav inset (HomeFragment's insets listener); the bottom margin reserves
         the bottom bar. fillViewport stretches the FrameLayout to the
         viewport so the mark centres in it. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">


            <!-- The brand mark + the field's slot, as ONE group centred in the
                 viewport (match_parent, centred by gravity, not width). The
                 bottom margin is the OPTICAL LIFT: FrameLayout
                 centres the box including margins, so the group sits that much
                 above the true centre (a start page's field sits above the
                 middle, not on it; values-land shrinks it). -->
            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginBottom="@dimen/home_mark_lift"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- Flame + the breathing ember glow behind it. 56dp — the
                     subject of the screen, not an app icon (it was 40dp when a
                     stat line shared the block). The glow is the flame's size
                     and only becomes a halo via the animator's SCALE
                     transform, drawn beyond the box because this and the
                     ancestors set clipChildren="false". The glow is GONE/alpha
                     0 at rest — HomeFragment shows it and runs the breath only
                     while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Where the pill rests. Exactly the pill's 48dp; the toolbar
                     is drawn over it (see the file comment). 28dp under the
                     wordmark: the docked toolbar box starts 8dp above this
                     slot, which leaves 20dp of clear canvas under the text. -->
                <Space
                    android:id="@+id/home_search_slot"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp" />

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap while docked over the slot. Laid out at the top (a top
         MARGIN of the status inset, set in HomeFragment); HomeToolbarDock owns
         its translation. -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar covers search, so the centre slot
        is the bookmarks-list entry. (The former hero Bookmarks FAB was
        removed.)
    -->

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
