<?xml version="1.0" encoding="utf-8"?>
<!--
    THE HOME IS THE ADDRESS BAR AND THE MARK (home v6, frame N2).
    Top-down: the search pill EXACTLY where the browser's address bar is (the
    same 64dp toolbar rect, the pill 8dp inside it), then the flame, the
    wordmark and one tonal "N trackers blocked" card centred in the page UNDER
    the bar, and the bottom navigation bar. Nothing moves on focus: the pill
    changes colour and corner in place (its own 225 ms animation) and the
    suggestions fade in under it on the same clock. Firedown's chrome lives on
    the two edges — the address bar above, the navigation bar below — and the
    home is the page between them: the shape of Edge, Samsung Internet and
    Firefox with its toolbar on top. The maintainer's pick (2026-10-12, canvas
    frames N1–N3) after two compositions that put the field INSIDE the page
    failed on-device: the mark-over-field stack read as a splash screen, and
    P1 (the field 88dp down, rising 80dp on focus) "does not work. In Chrome
    works because above the bar we have a toolbar and in the bottom the recent
    sites … in our case we have bottom navigation bar so we break harmony" — a
    lone field between two voids, while a bottom bar already frames the page
    from below. Firedown's own mark is the subject; the blocked line (frame
    H2, on a Material card at the maintainer's request) is the one figure, the
    door to Settings → Privacy → "Trackers and ads blocked". There is
    deliberately NO top-sites row, no recents, no download rows and no second
    counter: top sites and recents are what Chrome and Brave do, download
    status overlaps the Downloads screen, and the "blocked · saved" PAIR that
    used to sit under the wordmark wrapped onto two rows on 360dp phones in the
    long locales (two chips plus a dot needed 304dp of a 296dp line) — one
    line, one figure, fits. What the home still carries: the ember behind the
    flame while a download runs (status with no number). No cloud state either
    (maintainer, 2026-10-12): the transfer chip and the grace deadline card
    that sat under the field went with their plumbing — the Backups list and
    CloudWatchWorker's notifications carry those.

    THE PILL IS THE REAL GeckoToolbar, IN THE BROWSER'S RECT. A direct child of
    this CoordinatorLayout laid out at the top with a top MARGIN of the status
    inset (HomeFragment's insets listener; the browser's root pads the same
    inset, so the two toolbars occupy the same rect and the commit hand-off to
    the browser is a seamless cut). It never translates: the content reserves
    the toolbar's 64dp box as top padding (address_bar_height) so the mark
    centres in the space UNDER the bar, in portrait and landscape alike, and
    AutoCompleteViewBehavior (installed in code, as in the browser) opens the
    overlay at the toolbar's bottom. The home toolbar carries no hairline
    (toolbar_divider is keyed on !mHomeEnabled): the page under it is the same
    tone, and a line would cut the mark off from its bar. Two structural rules
    survive from the retired HomeToolbarDock (which translated this toolbar
    down over a Space in the content and raised it on focus, Chrome's fakebox
    model): the toolbar is declared AFTER the scroll view (equal elevation, so
    child order decides z and the content must not take the tap) and outside
    any AppBarLayout. The translation, the slot and the per-orientation rest
    dimens did not survive — see the CLAUDE.md home section for the record.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <!-- The content. Top padding = the status inset and bottom padding = the
         nav inset (HomeFragment's insets listener); the bottom margin reserves
         the bottom bar. fillViewport stretches the FrameLayout to the
         viewport. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <!-- paddingTop = the toolbar's box: the bar is drawn over this
             content at the top (see the file comment), so the page starts
             under it and the centred group is centred in the space BELOW the
             field — no per-orientation offset needed. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="@dimen/address_bar_height"
            android:paddingBottom="8dp">

            <!-- The brand mark — flame over wordmark over the blocked card —
                 CENTRED in the page under the bar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- Flame + the breathing ember glow behind it. 48dp — the
                     subject of the screen, not an app icon (40dp reads as one,
                     which it was when a stat line shared the block), but not
                     bigger: it shipped at 56dp over a 26sp wordmark and the
                     stacked pair measured ~100dp of mark over the 48dp field,
                     twice Chrome's logo-to-fakebox ratio, so the name led the
                     eye before the field. The glow is the flame's size
                     and only becomes a halo via the animator's SCALE
                     transform, drawn beyond the box because this and the
                     ancestors set clipChildren="false". The glow is GONE/alpha
                     0 at rest — HomeFragment shows it and runs the breath only
                     while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <!-- The name is a LABEL under the mark, not a second mark:
                     22sp (it shipped at 26sp — see the flame comment). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- The one figure on the home: lifetime requests blocked by
                     the built-in ad blocker (uBlock's cumulative count,
                     GeckoUblockHelper.getCumulativeBlockedLive), on a tonal
                     Material card under the wordmark — frame H2's shield
                     line, "put in a material card background" (maintainer,
                     2026-10-12). A tap opens Settings → Privacy → "Trackers
                     and ads blocked" (SettingsActivity.EXTRA_OPEN_BLOCKED_STATS,
                     Back returns here). TONAL, never a brand fill: a fill on
                     this screen is earned by work (the retired transfer
                     chip), a tally gets the surfaceContainerHigh pill the
                     backup pill had (20dp radius, 14/10/16/10 padding, 18dp
                     glyph, 13sp), glyph and text both in colorOnSurfaceVariant
                     — H2's grey — so the card stays quieter than the wordmark
                     above it. wrap_content and centred; the text may WRAP to
                     two lines (a count plus "trackers blocked" in a long
                     locale) rather than ellipsize the number away. Reads
                     "Protection active" at 0 (trackers_info_idle, the
                     settings row's rule: a "0 blocked" reads as broken
                     protection), so it is never empty and never GONE. The
                     incognito home carries NO such line — a figure there
                     would leak activity. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/home_blocked_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_shield_24"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/home_blocked_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:maxLines="2"
                            android:text="@string/trackers_info_idle"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            tools:text="12,345 trackers blocked" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap. Laid out at the top (a top MARGIN of the status inset,
         set in HomeFragment): the browser's exact toolbar rect, never
         translated. -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar covers search, so the centre slot
        is the bookmarks-list entry. (The former hero Bookmarks FAB was
        removed.)
    -->

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
