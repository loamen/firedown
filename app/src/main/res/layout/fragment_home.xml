<?xml version="1.0" encoding="utf-8"?>
<!--
    THE HOME IS THE FIELD HIGH AND THE MARK CENTRED (home v6, frame P1).
    Top-down: the search pill a little under the address bar's place
    (home_field_rest below the status strip, an 80dp rise on focus), then the
    flame and the wordmark centred in the viewport, decoupled from the field
    — Firefox's and Samsung Internet's shape (bar high, brand in the middle),
    the maintainer's pick (2026-10-12, canvas frames P0–P4) over the
    mark-over-field stack, which pinned near the top read as a splash screen
    with nothing under it and centred made the pill's rise ~350dp. Firedown's
    own mark is the subject. There
    is deliberately NO stat line, no top sites, no recent history, no download
    rows and no chip row: top sites and recents are what Chrome and Brave do,
    download status overlaps the Downloads screen, and the one-line counters
    that used to sit under the wordmark wrapped onto two rows on 360dp phones
    in the long locales (two chips plus a dot needed 304dp of a 296dp line).
    What the home still carries: the ember behind the flame while a download
    runs (status with no number). No cloud state either (maintainer, 2026-10-12):
    the transfer chip and the grace deadline card that sat under the field went
    with their plumbing — the Backups list and CloudWatchWorker's notifications
    carry those.

    THE PILL IS THE REAL GeckoToolbar. It is a direct child of this
    CoordinatorLayout laid out at the TOP (the exact rect the browser's
    toolbar occupies), and HomeToolbarDock translates it DOWN over the
    home_search_slot Space the content reserves; on focus it rises back to the
    top (Chrome's fakebox tween, see HomeToolbarDock) and the suggestions fade
    in under it (AutoCompleteViewBehavior follows the toolbar's translation, as
    in the browser). Three things this layout must keep for that to work:
      - the toolbar is NOT inside an AppBarLayout (a LinearLayout clips a
        translated child to its own bounds, so the docked pill would vanish),
        and it is declared AFTER the scroll view so it draws above the content
        and receives the tap;
      - the toolbar carries NO self-padding for the status inset — HomeFragment
        gives it a top MARGIN instead, so the box is a plain 64dp bar whose
        pill lands 8dp inside it, and the docked box's top edge sits 8dp above
        the slot rather than a whole status inset above it (which would paint
        over the wordmark);
      - the slot is exactly the pill's height and a direct, top-anchored
        child of the content — NOT inside the mark group, which is centred and
        fades; the slot must not move — and the docked box extends 8dp past
        the slot on both sides on an opaque holder, so nothing may sit within
        16dp of it.
    The AutoCompleteView has no XML behavior: HomeFragment installs
    AutoCompleteViewBehavior in code (it needs the view reference), the same
    way the browser does.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">


    <!-- The content. Top padding = the status inset and bottom padding = the
         nav inset (HomeFragment's insets listener); the bottom margin reserves
         the bottom bar. fillViewport stretches the FrameLayout to the
         viewport. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="8dp">


            <!-- Where the pill rests: a little UNDER its raised place, not on
                 it. Exactly the pill's 48dp, top-anchored at home_field_rest
                 below the status strip; the raised pill's top is inset + 8dp
                 (8dp inside the 64dp toolbar bar), so the rise on focus is
                 home_field_rest minus 8dp — 80dp in portrait, Chrome's nudge.
                 A SIBLING of the mark group, never its last child: the slot
                 must not move while the keyboard resizes the page (a moving
                 target re-aims the slide mid-flight), and the group is
                 centred. The toolbar is drawn over it (see the file
                 comment). -->
            <Space
                android:id="@+id/home_search_slot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/home_field_rest" />

            <!-- The brand mark — flame over wordmark — CENTRED in the viewport,
                 decoupled from the field above. It fades out as the pill
                 rises (HomeToolbarDock), so adjustResize re-centring it under
                 the keyboard is invisible; the thing that must not move is
                 the slot, which is why the slot is a sibling above rather
                 than this group's last child. home_mark_offset is 0 in
                 portrait (the true centre, the frame as drawn) and in
                 landscape the field's bottom edge, which centres the group in
                 the space UNDER the field: a FrameLayout centres the box
                 margins included, so a margin of F puts the content's centre
                 at (F + H)/2 — at the true centre of a ~280dp landscape
                 viewport the mark overlapped the field. -->
            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/home_mark_offset"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- Flame + the breathing ember glow behind it. 48dp — the
                     subject of the screen, not an app icon (40dp reads as one,
                     which it was when a stat line shared the block), but not
                     bigger: it shipped at 56dp over a 26sp wordmark and the
                     stacked pair measured ~100dp of mark over the 48dp field,
                     twice Chrome's logo-to-fakebox ratio, so the name led the
                     eye before the field. The glow is the flame's size
                     and only becomes a halo via the animator's SCALE
                     transform, drawn beyond the box because this and the
                     ancestors set clipChildren="false". The glow is GONE/alpha
                     0 at rest — HomeFragment shows it and runs the breath only
                     while a download is active. -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <View
                        android:id="@+id/home_brand_glow"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:background="@drawable/home_ember_glow"
                        android:visibility="gone" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_firedown_logo" />

                </FrameLayout>

                <!-- The name is a LABEL under the mark, not a second mark:
                     22sp (it shipped at 26sp — see the flame comment). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/app_name"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>


    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap while docked over the slot. Laid out at the top (a top
         MARGIN of the status inset, set in HomeFragment); HomeToolbarDock owns
         its translation. -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />


    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="?attr/colorSurfaceContainerLow"
        android:visibility="gone" />

    <!--
        Middle slot shows the flat Bookmarks button in-bar (no
        hideMiddleSlot) - the URL bar covers search, so the centre slot
        is the bookmarks-list entry. (The former hero Bookmarks FAB was
        removed.)
    -->

    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

    <View
        android:id="@+id/navigation_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="?android:attr/colorBackground" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
