<?xml version="1.0" encoding="utf-8"?>
<!-- The picture on the "Find your cloud app" page of the Backup screen's
     "Where to back up" sheet (BackupPlacesSheetDialogFragment): the system
     folder picker with its ☰ ringed in the brand and its drawer open on a
     cloud app. The picker hides cloud apps behind that button and never
     says so; the page's one line says it and this shows WHICH button,
     before the user is on a screen that is not ours. Decorative: the line
     under it carries it for a screen reader. Only the two apps verified to
     take a folder pick are named; the third entry is a skeleton line, as
     is the title, so the picture promises no folder and no other app. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_picker_guide_card"
    android:importantForAccessibility="noHideDescendants"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="178dp"
        android:background="@drawable/bg_picker_guide_screen">

        <!-- The picker's top bar: ☰, the title, search. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_picker_guide_ring"
                android:contentDescription="@null"
                android:padding="14dp"
                android:src="@drawable/ic_menu_24"
                app:tint="?attr/brandInk" />

            <View
                android:layout_width="72dp"
                android:layout_height="7dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_picker_guide_line" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search_24"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- The folder list behind the drawer: blocks, not content. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:orientation="vertical"
            android:paddingStart="168dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:background="@drawable/bg_picker_guide_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_picker_guide_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="22dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_picker_guide_row" />

        </LinearLayout>

        <!-- The drawer, open on a cloud app. -->
        <LinearLayout
            android:layout_width="156dp"
            android:layout_height="match_parent"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_picker_guide_drawer"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:background="@drawable/bg_picker_guide_pick"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="@string/folder_backup_guide_app_drive"
                android:textColor="?attr/colorOnSurface"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/cloud_outline_16"
                app:drawableTint="?attr/brandInk" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingHorizontal="8dp"
                android:text="@string/folder_backup_guide_app_nextcloud"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                app:drawableStartCompat="@drawable/cloud_outline_16"
                app:drawableTint="?attr/colorOnSurfaceVariant" />

            <View
                android:layout_width="64dp"
                android:layout_height="7dp"
                android:layout_marginStart="34dp"
                android:layout_marginTop="15dp"
                android:background="@drawable/bg_picker_guide_line" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
