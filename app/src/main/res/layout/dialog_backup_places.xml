<?xml version="1.0" encoding="utf-8"?>
<!-- The "Where to back up" chooser's content (a MaterialAlertDialog custom
     view; the title is the dialog's): the rows SyncSettingsFragment inflates
     from item_backup_place.xml, then ONE note — what the phone has (sign in
     to a cloud app first) or hasn't (no cloud app with folder access). A
     dialog can't carry a message AND a list, which is why the note is in
     here. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/places_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/places_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

    </LinearLayout>

</ScrollView>
