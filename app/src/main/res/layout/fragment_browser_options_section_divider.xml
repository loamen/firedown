<?xml version="1.0" encoding="utf-8"?>
<!--
  The boundary between the page the tab shows now and the captures from its
  earlier pages, in the Captured sheet. It is the strongest break in the
  list on purpose: a full-width line (CaptureSpacingDecoration gives this
  item no side inset, so the line runs edge to edge while every card stops
  at the gutter), then "Earlier in this tab" and the group's count in
  TitleMedium. It shipped first as a grey LabelLarge under an inset line,
  quieter than the "Images" header it outranks, and read on-device as no
  break at all (canvas "Captured Content sheet", board C).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="26dp"
    android:paddingBottom="6dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="true"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/section_title"
            style="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/capture_earlier_in_tab"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/section_count"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="3" />

    </LinearLayout>

</LinearLayout>
