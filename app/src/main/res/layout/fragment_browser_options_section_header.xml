<?xml version="1.0" encoding="utf-8"?>
<!--
  "Images  9" over a group's squares in the Captured sheet (unfiltered only:
  under a chip the chip names the type). The count is the whole group's, not
  the rows loaded so far. Horizontal inset comes from CaptureSpacingDecoration
  so the label lines up with the cards' edge.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/section_title"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_by_type_images"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/section_count"
        style="@style/TextAppearance.Material3.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        tools:text="9" />

</LinearLayout>
