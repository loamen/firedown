<?xml version="1.0" encoding="utf-8"?>
<!--
    The incognito home is the regular home's composition (fragment_home.xml —
    read its file comment first) with the mode's own mark: the privacy-bandit
    illustration in place of the flame, the "Private Browsing" title in place
    of the wordmark, and the SAME real GeckoToolbar docked over a slot a
    little under its raised place, with the mark centred below it (frame P1),
    raised the last 80dp on focus by HomeToolbarDock. One composition in
    both modes is what makes the shape recognisable in either. The one
    addition private mode genuinely needs is the faint, bottom-anchored
    disclaimer that private browsing isn't anonymity. No stats, no counters:
    a figure here would itself leak activity.

    Structural rules shared with fragment_home.xml: no AppBarLayout (it would
    clip the docked toolbar), the toolbar declared AFTER the scroll view (it
    draws above the content and takes the tap), a top MARGIN for the status
    inset instead of self-padding, the slot exactly the pill's height, and
    AutoCompleteViewBehavior installed in code.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incognito_surface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">

    <!-- Scrollable content area. Top padding = the status inset, bottom
         padding = the nav inset (HomeIncognitoFragment's insets listener); the
         bottom margin reserves the bottom-nav's height so the disclaimer never
         hides behind it in landscape, and remains scrollable into view —
         mirrors HomeFragment. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <!-- The FrameLayout (stretched to the viewport by fillViewport)
             anchors the field's slot at the top, centres the mark group and
             pins the disclaimer to the bottom. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp">

            <!-- Where the pill rests: a little UNDER its raised place, not on
                 it. Exactly the pill's 48dp, top-anchored at home_field_rest
                 below the status strip; the raised pill's top is inset + 8dp
                 (8dp inside the 64dp toolbar bar), so the rise on focus is
                 home_field_rest minus 8dp — 80dp in portrait, Chrome's nudge.
                 A SIBLING of the mark group, never its last child (see
                 fragment_home.xml): the slot
                 must not move while the keyboard resizes the page (a moving
                 target re-aims the slide mid-flight), and the group is
                 centred. The toolbar is drawn over it (see the file
                 comment). -->
            <Space
                android:id="@+id/home_search_slot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="top"
                android:layout_marginTop="@dimen/home_field_rest" />

            <!-- The mark group: illustration + title, centred in the viewport
                 like the regular home's (home_mark_offset: 0 in portrait, the
                 field's bottom edge in landscape — see fragment_home.xml). -->
            <LinearLayout
                android:id="@+id/home_brand_mark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/home_mark_offset"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- The "privacy bandit" illustration (already drawn in the
                     incognito purple/coral palette) is the mark here, in place
                     of the regular home's flame — richer and clearly
                     private-mode, no recolouring needed. adjustViewBounds keeps
                     its 6:5 aspect at a fixed width; 128dp (it was 168dp):
                     the mark centres in the space UNDER the field, ~180dp
                     tall in landscape, where 168dp plus the title does not
                     fit. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/incognito_home_title"
                    android:src="@drawable/ill_privacy_purple" />

                <!-- Set at the regular wordmark's size and weight so the two
                     homes read as one composition (22sp, a label under the
                     mark — see fragment_home.xml). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/incognito_home_title"
                    android:textColor="@color/incognito_on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- The one concession incognito carries that the regular home
                 doesn't: a faint privacy disclaimer pinned to the bottom, so
                 the mode never over-promises anonymity. Reuses the existing
                 (already-translated) warning string. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="0.75"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:paddingHorizontal="28dp"
                android:paddingBottom="12dp"
                android:text="@string/incognito_home_warning"
                android:textColor="@color/incognito_on_surface_variant"
                android:textSize="11sp" />

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap while docked over the slot (same as HomeFragment). -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />

    <!-- Autocomplete overlay (same as HomeFragment) -->
    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <!-- New tab flash overlay (same as HomeFragment) -->
    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="@color/incognito"
        android:visibility="gone" />

    <!--
        Bottom navigation bar — middle slot shows the flat Bookmarks
        button in-bar (no hideMiddleSlot). Same action as normal home:
        the bookmarks list is just URLs the user explicitly saved, so
        showing it from an incognito session leaks no private browsing
        state. (The former hero Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
