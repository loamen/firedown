<?xml version="1.0" encoding="utf-8"?>
<!--
    The incognito home is the regular home's composition (fragment_home.xml —
    read its file comment first) with the mode's own mark: the privacy-bandit
    illustration in place of the flame and the "Private Browsing" title in
    place of the wordmark, centred in the page under the SAME real
    GeckoToolbar sitting in the browser's exact rect (frame N2 — nothing moves
    on focus). One composition in both modes is what makes the shape
    recognisable in either. The one addition private mode genuinely needs is
    the faint, bottom-anchored disclaimer that private browsing isn't
    anonymity. No stats, no counters, no blocked card: a figure here would
    itself leak activity.

    Structural rules shared with fragment_home.xml: no AppBarLayout, the
    toolbar declared AFTER the scroll view (it draws above the content and
    takes the tap), a top MARGIN for the status inset instead of self-padding,
    the content's top padding = the toolbar's box, and AutoCompleteViewBehavior
    installed in code.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/incognito_surface"
    android:descendantFocusability="beforeDescendants"
    android:focusableInTouchMode="true">

    <!-- Scrollable content area. Top padding = the status inset, bottom
         padding = the nav inset (HomeIncognitoFragment's insets listener); the
         bottom margin reserves the bottom-nav's height so the disclaimer never
         hides behind it in landscape, and remains scrollable into view —
         mirrors HomeFragment. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <!-- The FrameLayout (stretched to the viewport by fillViewport) pads
             the toolbar's box on top, centres the mark group in the space
             under it and pins the disclaimer to the bottom. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="@dimen/address_bar_height"
            android:paddingBottom="8dp">

            <!-- The mark group: illustration + title, centred under the field
                 like the regular home's. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/address_bar_inset">

                <!-- The "privacy bandit" illustration (already drawn in the
                     incognito purple/coral palette) is the mark here, in place
                     of the regular home's flame — richer and clearly
                     private-mode, no recolouring needed. adjustViewBounds keeps
                     its 6:5 aspect at a fixed width; 128dp (it was 168dp):
                     the mark centres in the space UNDER the field, ~200dp
                     tall in landscape, where 168dp plus the title does not
                     fit. -->
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="128dp"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/incognito_home_title"
                    android:src="@drawable/ill_privacy_purple" />

                <!-- Set at the regular wordmark's size and weight so the two
                     homes read as one composition (22sp, a label under the
                     mark — see fragment_home.xml). -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:letterSpacing="-0.02"
                    android:text="@string/incognito_home_title"
                    android:textColor="@color/incognito_on_surface"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- The one concession incognito carries that the regular home
                 doesn't: a faint privacy disclaimer pinned to the bottom, so
                 the mode never over-promises anonymity. Reuses the existing
                 (already-translated) warning string. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:alpha="0.75"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:paddingHorizontal="28dp"
                android:paddingBottom="12dp"
                android:text="@string/incognito_home_warning"
                android:textColor="@color/incognito_on_surface_variant"
                android:textSize="11sp" />

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- The URL bar — declared AFTER the content so it draws above it and
         takes the tap; the browser's exact rect, never translated (same as
         HomeFragment). -->
    <com.solarized.firedown.geckoview.GeckoToolbar
        android:id="@+id/toolbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        app:enableHome="true" />

    <!-- Autocomplete overlay (same as HomeFragment) -->
    <com.solarized.firedown.autocomplete.AutoCompleteView
        android:id="@+id/auto_complete_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:elevation="@dimen/autocomplete_elevation"
        android:focusable="true" />

    <!-- New tab flash overlay (same as HomeFragment) -->
    <FrameLayout
        android:id="@+id/bottom_new_tab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="bottom"
        android:layout_marginTop="@dimen/app_bar_size"
        android:layout_marginBottom="@dimen/app_bar_size"
        android:background="@color/incognito"
        android:visibility="gone" />

    <!--
        Bottom navigation bar — middle slot shows the flat Bookmarks
        button in-bar (no hideMiddleSlot). Same action as normal home:
        the bookmarks list is just URLs the user explicitly saved, so
        showing it from an incognito session leaks no private browsing
        state. (The former hero Bookmarks FAB was removed.)
    -->
    <com.solarized.firedown.geckoview.toolbar.BottomNavigationBar
        android:id="@+id/bottom_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
